# ---- 数据库 ----
POSTGRES_DB=trading
POSTGRES_USER=trading
POSTGRES_PASSWORD=change-me-in-production
# 本机开发用 localhost，Docker 内用 postgres
DATABASE_URL=postgresql+asyncpg://trading:change-me-in-production@localhost:5432/trading

# ---- 模型 ----
# 必填：DeepSeek API Key。不填时系统启动但模型不可用（安全降级，不伪造）。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# ---- 提醒 ----
# 持久化价格监控；留空 webhook 则仅站内提醒。
ENABLE_ALERT_MONITOR=true
ALERT_POLL_SECONDS=5
FEISHU_WEBHOOK_URL=
