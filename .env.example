POSTGRES_DB=lobster
POSTGRES_USER=lobster
POSTGRES_PASSWORD=change-me-for-non-local-use
DATABASE_URL=postgresql+asyncpg://lobster:change-me-for-non-local-use@localhost:5432/lobster

# The default model supports tool calling. Never commit a real key.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Persistent price monitoring. Keep webhook empty for site-only alerts.
ENABLE_ALERT_MONITOR=true
ALERT_POLL_SECONDS=5
FEISHU_WEBHOOK_URL=
